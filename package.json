{
  "name": "stock-widget",
  "type": "module",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:offline": "vite build --mode offline",
    "preview": "vite preview",
    "update:widgetjs": "widget dependencies -t remote",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "release": "widget release -t ftp",
    "release:offline": "widget release -t ftp -f release-offline.json",
    "download:logo": "esno download-coin-logos.ts",
    "build:release": "npm run build && widget release -t ftp",
    "remote": "widget dependencies -t remote"
  },
  "packageManager": "pnpm@9.15.2",
  "dependencies": {
    "@icon-park/vue-next": "^1.4.2",
    "@types/color": "^4.2.0",
    "@vueuse/core": "^11.0.1",
    "@vueuse/integrations": "^12.4.0",
    "@widget-js/core": "^24.1.1-beta.72",
    "@widget-js/vue3": "^24.1.1-beta.74",
    "axios": "^1.7.4",
    "color": "^4.2.3",
    "consola": "^3.2.3",
    "echarts": "^5.6.0",
    "element-plus": "^2.8.1",
    "localforage": "^1.10.0",
    "sortablejs": "^1.15.6",
    "vue": "^3.3.11",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.8.0",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.19.3",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vue/tsconfig": "^0.5.0",
    "@widget-js/vite-plugin-widget": "^24.1.1-beta.71",
    "eslint": "^9.14.0",
    "esno": "^4.8.0",
    "lint-staged": "^15.2.10",
    "sass": "^1.83.1",
    "simple-git-hooks": "^2.11.1",
    "typescript": "~5.3.0",
    "unocss": "^0.63.6",
    "unplugin-auto-import": "^0.11.4",
    "unplugin-vue-components": "^0.22.9",
    "vite": "^5.0.10",
    "vue-tsc": "^1.8.25"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md}": [
      "eslint --cache --fix"
    ]
  }
}